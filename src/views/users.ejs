<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>All Registered Users</h2>
        <p>This management panel is restricted exclusively to authorized administrators.</p>

        <% if (usersList && usersList.length> 0) { %>
            <table class="users-table"
                style="width: 100%; border-collapse: collapse; margin-top: 1.5rem; text-align: left;">
                <thead>
                    <tr style="background-color: #eee; border-bottom: 2px solid #ccc;">
                        <th style="padding: 0.75rem;">Name</th>
                        <th style="padding: 0.75rem;">Email / Username</th>
                        <th style="padding: 0.75rem;">System Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% usersList.forEach(registeredUser=> { %>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <td style="padding: 0.75rem;">
                                <%= registeredUser.name %>
                            </td>
                            <td style="padding: 0.75rem;">
                                <%= registeredUser.email %>
                            </td>
                            <td style="padding: 0.75rem;">
                                <% if (registeredUser.role_name==='admin' ) { %>
                                    <span
                                        style="padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem; font-weight: bold; background-color: #d4edda; color: #155724;">
                                        <%= registeredUser.role_name %>
                                    </span>
                                    <% } else { %>
                                        <span
                                            style="padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem; font-weight: bold; background-color: #e2e3e5; color: #383d41;">
                                            <%= registeredUser.role_name %>
                                        </span>
                                        <% } %>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <% } else { %>
                <p>No registered users found in the database.</p>
                <% } %>

                    <p style="margin-top: 2rem;"><a href="/dashboard">Back to Dashboard</a></p>
    </main>

    <%- include('partials/footer') %>