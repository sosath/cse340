<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= categoryDetails.name %>
        </h2>

        <h3>Service Projects</h3>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </li>
                <% }) %>
        </ul>

        <hr style="margin-top: 2rem; border: 0; border-top: 1px solid #ccc;">

        <p style="margin-top: 1rem;">
            <a href="/edit-category/<%= categoryDetails.category_id %>" class="btn-link">
                Edit Category Name
            </a>
        </p>

    </main>
    <%- include('partials/footer') %>