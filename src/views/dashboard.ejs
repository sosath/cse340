<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <div class="dashboard-info">
            <p><strong>Name:</strong>
                <%= name %>
            </p>
            <p><strong>Username:</strong>
                <%= email %>
            </p>
        </div>

        <% if (user && user.role_name==='admin' ) { %>
            <div class="admin-controls"
                style="margin-top: 2rem; padding: 1rem; border: 1px dashed #ccc; background-color: #f9f9f9;">
                <h3>Administrative Tools</h3>
                <p><a href="/users" class="btn-link" style="font-weight: bold; color: #0066cc;">Manage Users (View
                        Registered List)</a></p>
            </div>
            <% } %>
    </main>

    <%- include('partials/footer') %>