<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p><a href="/new-project" class="btn-link">Add a New Service Project</a></p>

        <p>Upcoming Service Projects:</p>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= new Date(project.date).toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                            year: 'numeric' , timeZone: 'UTC' }) %>:
                    </strong>

                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>

                    (<em>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </em>)

                    <br>
                    <small>
                        <%= project.description %> — 📍 <%= project.location %>
                    </small>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>